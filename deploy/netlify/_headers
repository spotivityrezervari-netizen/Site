# Public browser assets only. Supabase enforces data/role permissions separately.
/*
  Content-Security-Policy: default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; script-src 'self' https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.3; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; img-src 'self' data: blob: https://ndubcdwohqzgxpuiowye.supabase.co; connect-src 'self' https://ndubcdwohqzgxpuiowye.supabase.co wss://ndubcdwohqzgxpuiowye.supabase.co https://api.pwnedpasswords.com; font-src 'self'; media-src 'none'; worker-src 'none'; manifest-src 'self'; form-action 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), display-capture=()
  Strict-Transport-Security: max-age=31536000

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Speed: every page links its scripts and styles with ?v=N, so browsers may keep
# them for a day and refresh them in the background for a week after that.
/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/terenuri/*
  Cache-Control: no-cache

/teren/*
  Cache-Control: no-cache

/baze-sportive/*
  Cache-Control: no-cache

/sitemap.xml
  Cache-Control: no-cache

/robots.txt
  Cache-Control: no-cache

# Photos and icons of the site itself (not the uploads in Supabase).
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
